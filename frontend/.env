# Kosongkan VITE_API_URL saat development: Vite mem-proxy /api ke localhost:3000.
# Isi URL lengkap hanya saat backend-serving atau deploy (mis. https://api.sekolah.sch.id).
VITE_API_URL=

# Secret dari tabel perangkat_absen. Nilai ini ikut ter-bundle ke browser - untuk
# produksi, pindahkan verifikasi perangkat ke backend-for-frontend.
VITE_PERANGKAT_SECRET=rahasia-123