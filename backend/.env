DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=absensi_wajah
DB_CONNECTION_LIMIT=10

# Kunci penanda tangan token dashboard. WAJIB diganti di produksi.
# Kalau kosong, kunci acak dibuat tiap boot (semua sesi gugur saat restart).
AUTH_SECRET=ganti-dengan-string-acak-panjang-di-produksi
AUTH_JAM_VALID=8

# Notifikasi WhatsApp (opsional). Tanpa ini, absensi tetap berjalan normal.
WA_PROVIDER=fonnte
WA_TOKEN=
WA_URL=